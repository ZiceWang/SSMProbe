.coverage
.coverage.*
htmlcov/

# Jupyter
.ipynb_checkpoints/

# IDE/editor
.vscode/
.idea/

# Logs and temporary files
*.log
*.tmp
tmp/

# Benchmark outputs
benchmarks/*.csv
benchmarks/*.json
